# CookCraft Frontend
# Vite only exposes vars prefixed with VITE_, and it bakes them in at
# BUILD time — so on Render these must be set as the Static Site's
# "Environment Variables" *before* the build runs, not read at runtime.

# Backend API base URL (deployed backend + /api)
VITE_API_URL=https://cookcraft-backend.onrender.com/api
# Backend origin used to resolve uploaded image URLs
VITE_UPLOAD_URL=https://cookcraft-backend.onrender.com

# Firebase (values are public identifiers, not secrets — safe to set
# in Render's dashboard as plain env vars)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
