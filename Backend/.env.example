# CookCraft Backend
JWT_SECRET=your-secret-key-change-in-production
PORT=5000

# Public URL of THIS backend once deployed on Render, e.g.
# https://cookcraft-backend.onrender.com
# Used to build absolute image URLs returned by the API.
API_BASE_URL=http://localhost:5000

# URL(s) of the deployed frontend, comma-separated if you need more than
# one (e.g. production + local dev). Used for the CORS allowlist.
# e.g. https://cookcraft-frontend.onrender.com,http://localhost:5173
FRONTEND_URL=http://localhost:5173
